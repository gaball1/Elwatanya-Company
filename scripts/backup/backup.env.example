# =============================================================================
# El Wataniya ERP - Backup & Recovery configuration
# Copy this file to `backup.env` (same directory) and adjust the values.
# `backup.env` is git-ignored and must NOT be committed.
#
# Every value has a safe default; only credentials/config you change are needed.
# Passwords are read from the environment / backend/.env and are NEVER printed.
# =============================================================================

# --- PostgreSQL connection ----------------------------------------------------
# The scripts prefer to run pg_dump/psql INSIDE the Postgres container, so in
# most setups you only need POSTGRES_CONTAINER + POSTGRES_USER + POSTGRES_DB.
# Set POSTGRES_NETWORK so a throwaway `docker run` pg client can reach the DB.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=elwataniya
POSTGRES_DB=elwataniya_erp
POSTGRES_CONTAINER=elwataniya-postgres
POSTGRES_NETWORK=elwataniya-company_default
# Password for native (non-container) pg_dump/psql. If empty, the scripts try
# to derive it from DATABASE_URL in backend/.env. Never hardcode it in scripts.
POSTGRES_PASSWORD=

# --- Backup destination -------------------------------------------------------
# Directory where timestamped backups are written (created if missing).
BACKUP_DIR=./backups
# Custom-format dump file prefix.
BACKUP_PREFIX=elwataniya_erp
# Retention in days: backups older than this are pruned (0 = keep forever).
BACKUP_RETENTION_DAYS=14
# Comma-separated list of application uploads/storage directories to include.
BACKUP_UPLOAD_DIRS=./backend/uploads,./uploads

# --- External / off-server storage (optional) ---------------------------------
# Runs after the local backup completes. The file paths are available as
# environment variables BACKUP_DB_FILE / BACKUP_FILES_ARCHIVE / BACKUP_NAME.
# Example (rclone):  rclone copy "$BACKUP_FILES_ARCHIVE" "remote:erp-backups/"
# Example (AWS):     aws s3 cp "$BACKUP_DB_FILE" s3://my-bucket/erp-backups/
# Example (scp):     scp "$BACKUP_DB_FILE" "$BACKUP_FILES_ARCHIVE" user@host:/backups/
# Leave empty to keep backups local only (a warning is printed).
BACKUP_EXTERNAL_COMMAND=

# --- Scheduled job ------------------------------------------------------------
# Backup interval. Windows Task Scheduler uses /ST /RI; cron uses the example in
# scripts/backup/schedule-cron.example. No application uptime is required.
BACKUP_SCHEDULE_START_TIME=02:00
BACKUP_SCHEDULE_INTERVAL_MINUTES=1440
