# PostgreSQL (Docker)
POSTGRES_USER=elwataniya
POSTGRES_PASSWORD=elwataniya_secret
POSTGRES_DB=elwataniya_erp
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://elwataniya:elwataniya_secret@localhost:5432/elwataniya_erp?schema=public
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
