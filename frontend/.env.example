# Browser-facing API origin. In dev keep localhost:3001. In production this
# MUST be the public HTTPS origin reached through the TLS reverse proxy,
# e.g. https://erp.example.com/api/v1  (never a docker-internal hostname).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Server-only: target for the Next.js rewrites. Defaults to NEXT_PUBLIC_API_URL.
# In production set to the internal backend, e.g. http://backend:3001/api/v1
# BACKEND_API_URL=http://backend:3001/api/v1
