DATABASE_URL="postgresql://elwataniya:elwataniya_secret@localhost:5432/elwataniya_erp?schema=public"
# Generate strong secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The backend refuses placeholder values and enforces >= 32 chars outside development/test.
JWT_SECRET=""
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# When false, POST /auth/register is disabled (recommended for production).
# Accounts must be provisioned by an administrator.
ALLOW_PUBLIC_REGISTRATION=false
# Cap concurrent PDF renders to protect the headless renderer (0 = unlimited).
# PDF_MAX_CONCURRENT_RENDERS=4

# AI Agent (LLM) — optional; when OPENAI_API_KEY is empty the agent runs a deterministic fallback.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_TEMPERATURE=0.2
# OPENAI_MAX_TOKENS=1024
# OPENAI_MAX_ITERATIONS=6
# AI_AGENT_API_URL="http://localhost:3001"

# --- Production notes --------------------------------------------------------
# TLS: serve behind a TLS-terminating reverse proxy (nginx/caddy/traefik) with
# Secure; HttpOnly cookies. Attendance GPS/camera are hard-blocked on non-HTTPS
# origins (browser isSecureContext). See docs/PRODUCTION_READINESS_AUDIT.md INF-02.
#
# PostgreSQL: docker-compose binds the port to 127.0.0.1 only (not exposed to
# the network). For remote database access, use an SSH tunnel or a managed
# database service and update DATABASE_URL accordingly.
#
# Backups: local-only by default. Set BACKUP_EXTERNAL_COMMAND in
# scripts/backup/backup.env to copy each artifact off the host (rclone/aws s3/scp).
# See docs/PRODUCTION_BACKUP_RECOVERY.md.
