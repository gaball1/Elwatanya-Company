// Prisma schema for Construction ERP - Final BOQ enhancements

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Enums
enum DeductionTypeEnum {
  INSURANCE
  RETENTION
  TAXES
  ADVANCES
  PENALTIES
  PREVIOUS_PAYMENTS
  CUSTOM
}

model Project {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  buildings Building[]
  finalBoqs FinalBoq[]
}

model Building {
  id               String             @id @default(uuid())
  projectId        String
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  project          Project            @relation(fields: [projectId], references: [id])
  finalBoqs            FinalBoq[]
  employerBoqItems     EmployerBoqItem[]
  analyticalBoqItems   AnalyticalBoqItem[]
  buildingSubcontractors BuildingSubcontractor[]
  contractorBoqs       ContractorBoq[]
}

model EmployerBoqItem {
  id          String   @id @default(uuid())
  buildingId  String
  itemCode    String
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalValue  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  building    Building @relation(fields: [buildingId], references: [id])

  @@unique([buildingId, itemCode])
  @@index([buildingId])
}

model AnalyticalBoqItem {
  id          String   @id @default(uuid())
  buildingId  String
  itemCode    String
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalValue  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  building    Building @relation(fields: [buildingId], references: [id])

  @@unique([buildingId, itemCode])
  @@index([buildingId])
}

model FinalBoq {
  id            String         @id @default(uuid())
  version       Int            @default(1)
  buildingId    String
  projectId     String // added for uniqueness scope
  businessCode  String // BOQ code unique within project
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  building      Building       @relation(fields: [buildingId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  items         FinalBoqItem[]
  distributions Distribution[]

  @@unique([projectId, businessCode])
  @@index([id, version])
}

model FinalBoqItem {
  id               String            @id @default(uuid())
  version          Int               @default(1)
  finalBoqId       String
  businessCode     String // item code unique within its FinalBoq
  description      String
  unit             String
  unitPrice        Decimal           @db.Decimal(12, 2)
  quantity         Decimal           @db.Decimal(12, 2)
  totalValue       Decimal           @db.Decimal(12, 2)
  itemStatus       String            @default("pending") // pending|analyzed|partial|distributed|completed
  sortOrder        Int // explicit ordering
  parentItemId     String? // optional self‑reference for hierarchy
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  finalBoq         FinalBoq          @relation(fields: [finalBoqId], references: [id])
  components       Component[]
  distributionRows DistributionRow[]

  @@unique([finalBoqId, businessCode])
  @@index([parentItemId])
  @@index([id, version])
}

model Component {
  id               String            @id @default(uuid())
  version          Int               @default(1)
  finalBoqItemId   String
  businessCode     String // code unique within its owning FinalBoqItem
  description      String
  unit             String
  unitPrice        Decimal           @db.Decimal(12, 2)
  quantity         Decimal           @db.Decimal(12, 2)
  totalValue       Decimal           @db.Decimal(12, 2)
  lifecycleStatus  String            @default("pending")
  sortOrder        Int // stable ordering of components
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  finalBoqItem     FinalBoqItem      @relation(fields: [finalBoqItemId], references: [id])
  distributionRows DistributionRow[]
  contractorBoqItems ContractorBoqItem[]

  @@unique([finalBoqItemId, businessCode])
  @@index([id, version])
}

// other models
model Subcontractor {
  id                     String                  @id @default(uuid())
  name                   String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  contractorBoqs         ContractorBoq[]
  buildingSubcontractors BuildingSubcontractor[]
}

model BuildingSubcontractor {
  id              String        @id @default(uuid())
  buildingId      String
  subcontractorId String
  workType        String
  agreedPrice     Decimal?      @db.Decimal(12, 2)
  status          String        @default("active")
  assignedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  building        Building      @relation(fields: [buildingId], references: [id])
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id])

  @@unique([buildingId, subcontractorId])
  @@index([buildingId])
}

model ContractorBoq {
  id              String              @id @default(uuid())
  buildingId      String
  subcontractorId String
  workType        String?
  version         Int                 @default(1)
  status          String // Draft, Approved, InProgress, Completed, Cancelled
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  building        Building            @relation(fields: [buildingId], references: [id])
  subcontractor   Subcontractor       @relation(fields: [subcontractorId], references: [id])
  items           ContractorBoqItem[]
  statements      Statement[]

  @@unique([buildingId, subcontractorId])
  @@index([buildingId])
}

model ContractorBoqItem {
  id                String                     @id @default(uuid())
  contractorBoqId   String
  itemCode          String
  description       String
  unit              String
  unitPrice         Decimal                    @db.Decimal(12, 2)
  quantity          Decimal                    @db.Decimal(12, 2)
  assignedQuantity  Decimal                    @db.Decimal(12, 2)
  totalValue        Decimal                    @db.Decimal(12, 2)
  finalItemId       String?
  componentId       String?
  version           Int                        @default(1)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?
  contractorBoq     ContractorBoq              @relation(fields: [contractorBoqId], references: [id])
  component         Component?                 @relation(fields: [componentId], references: [id])
  versions          ContractorBoqItemVersion[]
  statementItems    StatementItem[]

  @@unique([contractorBoqId, itemCode, componentId])
  @@index([contractorBoqId])
}

model ContractorBoqItemVersion {
  contractorBoqItemId String
  version             Int
  quantity            Decimal           @db.Decimal(12, 2)
  unitPrice           Decimal           @db.Decimal(12, 2)
  createdAt           DateTime          @default(now())
  contractorBoqItem   ContractorBoqItem @relation(fields: [contractorBoqItemId], references: [id])

  @@id([contractorBoqItemId, version])
}

model Statement {
  id               String               @id @default(uuid())
  contractorBoqId  String
  sequenceNumber   Int
  status           String // running | final (mirrors frontend ExtractStatus)
  runningNumber    Int?
  label            String?
  insurancePercent Decimal              @default(5) @db.Decimal(12, 2)
  extractDate      DateTime             @default(now())
  previousPaid     Decimal              @default(0) @db.Decimal(12, 2)
  totalWorkValue   Decimal              @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal              @default(0) @db.Decimal(12, 2)
  netPayable       Decimal              @default(0) @db.Decimal(12, 2)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  contractorBoq    ContractorBoq        @relation(fields: [contractorBoqId], references: [id])
  items            StatementItem[]
  deductions       StatementDeduction[]
  payments         Payment[]
}

model StatementItem {
  statementId         String
  contractorBoqItemId String
  itemCode            String
  description         String              @default("")
  unit                String              @default("")
  contractQuantity    Decimal             @default(0) @db.Decimal(12, 2)
  previousQuantity    Decimal             @db.Decimal(12, 2)
  currentQuantity     Decimal             @db.Decimal(12, 2)
  totalQuantity       Decimal             @default(0) @db.Decimal(12, 2) // previous + current
  executionPercent    Decimal             @default(100) @db.Decimal(12, 2)
  totalExecuted       Decimal             @db.Decimal(12, 2) // executedQuantity
  unitPrice           Decimal             @db.Decimal(12, 2)
  currentWorkValue    Decimal             @db.Decimal(12, 2) // workValue
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  statement           Statement           @relation(fields: [statementId], references: [id])
  contractorBoqItem   ContractorBoqItem   @relation(fields: [contractorBoqItemId], references: [id])

  @@id([statementId, contractorBoqItemId])
}

model StatementDeduction {
  id          String            @id @default(uuid())
  statementId String
  type        DeductionTypeEnum
  amount      Decimal           @db.Decimal(12, 2)
  customLabel String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  statement   Statement         @relation(fields: [statementId], references: [id])
}

model Payment {
  id          String    @id @default(uuid())
  statementId String?
  buildingId  String?
  contractorId String?
  amount      Decimal   @db.Decimal(12, 2)
  paidAt      DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  statement   Statement? @relation(fields: [statementId], references: [id])
}

model Distribution {
  id         String            @id @default(uuid())
  finalBoqId String
  status     String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deletedAt  DateTime?
  finalBoq   FinalBoq          @relation(fields: [finalBoqId], references: [id])
  rows       DistributionRow[]
}

model DistributionRow {
  id                String        @id @default(uuid())
  distributionId    String
  finalBoqItemId    String?
  componentId       String?
  contractorId      String
  allocatedQuantity Decimal       @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  distribution      Distribution  @relation(fields: [distributionId], references: [id])
  finalBoqItem      FinalBoqItem? @relation(fields: [finalBoqItemId], references: [id])
  component         Component?    @relation(fields: [componentId], references: [id])
}

enum UserRole {
  CEO
  TECHNICAL_OFFICE
  ACCOUNTANT
  SITE_ENGINEER
  STORE_MANAGER
  EMPLOYEE
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  name              String
  passwordHash      String
  role              UserRole             @default(EMPLOYEE)
  status            String               @default("ACTIVE")
  projectId         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  refreshTokens     RefreshToken[]
  roleAssignments   UserRoleAssignment[]
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@index([name])
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([name])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
