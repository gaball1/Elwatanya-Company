{
  "name": "elwataniya-company",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:studio": "npm run prisma:studio --workspace=backend",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup/backup.ps1",
    "backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup/restore-verify.ps1"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "description": "Production-grade ERP system for construction companies.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gaball1/Elwatanya-Company.git"
  },
  "keywords": [],
